{
  "name": "distributed-load-testing-platform",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "worker": "tsx src/server/apps/worker/src/main.ts",
    "worker:dev": "tsx watch src/server/apps/worker/src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ui && npm run test:server",
    "test:ui": "vitest run",
    "test:server": "jest --runInBand",
    "test:e2e": "jest --runInBand --testRegex \".*\\.e2e-spec\\.ts$\"",
    "test:integration": "jest --runInBand --testRegex \".*\\.integration-spec\\.ts$\"",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/server/libs/database/src/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/typeorm": "^11.0.0",
    "@tanstack/react-query": "^5.101.2",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.0.0",
    "ioredis": "^5.0.0",
    "joi": "^17.13.8",
    "lucide-react": "^1.22.0",
    "next": "16.3.6",
    "pg": "^8.0.0",
    "prom-client": "^15.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.31",
    "tsx": "^4.20.0",
    "uuid": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "^11.1.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "js-yaml": "4.3.2",
    "multer": "2.4.0",
    "qs": "6.16.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/server/**/*.ts",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": ["<rootDir>/.next/"],
    "moduleNameMapper": {
      "^server-only$": "<rootDir>/src/test/server-only.ts",
      "^@app/(.*)$": "<rootDir>/src/server/libs/$1/src",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
